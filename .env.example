# Environment variable contract
#
# This file is a TEMPLATE. Every value is intentionally empty. Never commit a
# real key, token, password, or connection string — copy this file to `.env`
# (git-ignored) and fill it in locally.
#
# Vite splits environment variables into two buckets, and the boundary is a
# security boundary:
#
#   1. `VITE_*`        -> injected into the browser bundle at BUILD time.
#                         Anything readable in DevTools or in the shipped
#                         `dist/` JS. Treat these as PUBLIC. Never put a secret
#                         here.
#   2. everything else -> not reachable by the browser at all. The Node API
#                         process reads these from `process.env`.
#
# The AI provider key lives in the second group and is read only by
# server/src/services/ai/providers/. It is never sent to the browser.

# ---------------------------------------------------------------------------
# Browser-visible (VITE_*) — public by definition, no secrets allowed
# ---------------------------------------------------------------------------

# Leave EMPTY for local development. The client then calls the relative path
# '/api/chat' and the Vite dev proxy (see API_PROXY_TARGET below) forwards it to
# Express, which keeps everything same-origin and avoids CORS preflights.
# Set an absolute URL only when the API is on a different host, e.g. deployed.
VITE_API_BASE_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Server-only (NO `VITE_` prefix) — never shipped to the browser
# ---------------------------------------------------------------------------

# --- Core server ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Comma-separated allowlist. A wildcard is rejected at boot when
# NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173

# Clerk keys are available in your Clerk Dashboard. The server-side publishable
# key is public; the secret key must never use a VITE_ prefix.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# PostgreSQL connection. Start the development database with `docker compose up -d db`.
DATABASE_URL=postgres://chatbot:chatbot_dev_only@127.0.0.1:5432/chatbot

# Uploaded file bytes are stored privately outside static/public assets.
UPLOAD_STORAGE_DIR=.private-uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Read client IPs from X-Forwarded-For. Required in production, otherwise every
# visitor collapses into one rate-limit bucket behind a proxy.
TRUST_PROXY=false

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
CHAT_DAILY_QUOTA=100

BODY_LIMIT=100kb

# --- Vite dev proxy target (read by vite.config.js in Node, NOT the browser) ---
API_PROXY_TARGET=http://127.0.0.1:3000

# --- AI provider ---
# `local`             = deterministic offline provider, no credentials/network.
# `openai`            = OpenAI, configured with OPENAI_API_KEY and OPENAI_MODEL.
# Gemini and Claude become selectable when their server-only keys are set.
# `openai-compatible` = another compatible /chat/completions endpoint.
AI_PROVIDER=local
AI_DEFAULT_MODEL=

# Provider credentials and vendor model names are server-side only; never use
# a VITE_ prefix. The frontend sees only safe IDs returned by GET /api/models.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_SUPPORTS_VISION=true

# Document embeddings use OpenAI's embedding API (server-side only).
# The embedding model must produce 1536-dimensional vectors for the pgvector schema.
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.25

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

# Optional generic overrides for OpenAI-compatible endpoints. Keep blank for
# direct OpenAI configuration; server-side only.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_TOKENS=512

# --- Request limits (server-side enforcement) ---
MAX_MESSAGES_PER_REQUEST=50
MAX_CONTENT_LENGTH=4000
